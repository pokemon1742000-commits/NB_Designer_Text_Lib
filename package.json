{
  "name": "nb-textlib-exporter",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "deploy": "git add -A && git commit -m \"update\" && npm run build && git push",
    "release:auto": "node scripts/release.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nbtextlib.exporter",
    "productName": "NB TextLib Exporter",
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "auto_import.py",
      "inspect_textlib.py",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
