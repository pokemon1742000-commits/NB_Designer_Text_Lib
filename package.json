{
  "name": "nb-textlib-exporter",
  "version": "1.0.3",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:helper": "py -3 -m PyInstaller --onefile --noconsole --distpath dist-py --workpath build-py --specpath build-py auto_import.py",
    "build": "npm run build:helper && electron-builder",
    "build:publish": "npm run build:helper && electron-builder --publish always",
    "deploy": "git add -A && git commit -m \"update\" && npm run build && git push",
    "release:auto": "node scripts/release.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nbtextlib.exporter",
    "productName": "NB TextLib Exporter",
    "asar": false,
    "publish": {
      "provider": "github"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "auto_import.py",
      "inspect_textlib.py",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-py/auto_import.exe",
        "to": "auto_import.exe"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
